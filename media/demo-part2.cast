[2.208, "o", "\u001b[2mThe measurement moved. The sealed value did not, because the seal lives in the keystore, not in the image.\u001b[0m\r\n"]
[2.629, "o", "\u001b[1;32m$\u001b[0m python3 /Users/shk/code/sealed-workspace/sealed/cli/sealed.py -p /dev/cu.usbmodemV6VJDB3 sign --tx tx.bin\r\n"]
