[2.684, "o", "HOST_DIGEST=332f7ba20cf88b70d342becb5b4944e58cb50bda1ccd815dd7c6c04222a743dd\r\n"]
[2.739, "o", "REFUSED reason=MEASUREMENT_MISMATCH\r\n"]
[2.794, "o", "SEALED_MEASURE=3eecd519bfeb9e39da607e8aaf7f795c15f6013ef0c200edb5f3941488bbdd8e\r\n"]
[2.849, "o", "MEASURE=44c9cb139733065c9d92f70990fe0a64f4804da7564a9c21389703e489b1c627\r\n"]
[2.904, "o", "ERR running image is not the image that was sealed\r\n"]
[2.959, "o", "RESULT=REFUSED\r\n"]
[3.014, "o", "\u001b[31m[exit 2]\u001b[0m\r\n"]
[4.751, "o", "\u001b[2mThat is the whole idea: no network, no vendor, no \"please don't\". The key is not released.\u001b[0m\r\n"]
