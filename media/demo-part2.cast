[0.0, "o", "\u001b[2mPart 2 \u2014 same board, same key, one character of policy changed\u001b[0m\r\n"]
[0.384, "o", "\u001b[2mThe policy now reads  gate=measure-before-unsea1  (the last character is a digit 1, not an L)\u001b[0m\r\n"]
[0.807, "o", "\u001b[1;32m$\u001b[0m python3 /Users/shk/code/sealed-workspace/sealed/cli/sealed.py -p /dev/cu.usbmodemV6VJDB3 status\r\n"]
