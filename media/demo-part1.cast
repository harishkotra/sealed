{"version": 2, "width": 104, "height": 30, "timestamp": 1794218560, "env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "title": "part 1"}
[0.0, "o", "part 1\n"]
[0.0, "o", "\u001b[2mSEALED \u2014 a signing key that refuses to sign when the board is not running the image you published\u001b[0m\r\n"]
[0.424, "o", "\u001b[2mBaochip Dabao, headless. Everything below was driven from this machine over USB-C.\u001b[0m\r\n"]
[2.124, "o", "\u001b[1;32m$\u001b[0m python3 /Users/shk/code/sealed-workspace/sealed/cli/sealed.py ports\r\n"]
[2.124, "o", "/dev/cu.usbmodemV6VJDB3\r\n"]
[3.196, "o", "\u001b[2mThe board is running the sealed image: it hashed its own 96-byte policy blob in RAM.\u001b[0m\r\n"]
[3.609, "o", "\u001b[1;32m$\u001b[0m python3 /Users/shk/code/sealed-workspace/sealed/cli/sealed.py -p /dev/cu.usbmodemV6VJDB3 status\r\n"]
[3.609, "o", "MEASURE=3eecd519bfeb9e39da607e8aaf7f795c15f6013ef0c200edb5f3941488bbdd8e\r\n"]
[3.664, "o", "MEASURE_LEN=96\r\n"]
[3.719, "o", "SLOTS=1400,1401,1402,1403\r\n"]
[3.774, "o", "SIGNS=3\r\n"]
[3.829, "o", "MODE=owner-enrolled-dev\r\n"]
[3.884, "o", "STATE=enrolled\r\n"]
[3.939, "o", "SEALED_MEASURE=3eecd519bfeb9e39da607e8aaf7f795c15f6013ef0c200edb5f3941488bbdd8e\r\n"]
[3.994, "o", "VERDICT=MATCH\r\n"]
[4.049, "o", "PUBKEY=041277c6c58f2386c299c843d55e6ee5ec0389b3d329e997383ca2acb8ace759bdc6f5c7584f115cdf6de78350310facf3bc5ba472867f396fc7fa7c6738aea453\r\n"]
[4.104, "o", "OK\r\n"]
[5.052, "o", "\u001b[2mAsk it to sign something. The host verifies the signature with stdlib Python only.\u001b[0m\r\n"]
[5.476, "o", "\u001b[1;32m$\u001b[0m echo \"payment 42\" > tx.bin\r\n"]
[6.013, "o", "\u001b[1;32m$\u001b[0m python3 /Users/shk/code/sealed-workspace/sealed/cli/sealed.py -p /dev/cu.usbmodemV6VJDB3 sign --tx tx.bin\r\n"]
[6.013, "o", "TX_FILE=tx.bin\r\n"]
[6.068, "o", "HOST_DIGEST=332f7ba20cf88b70d342becb5b4944e58cb50bda1ccd815dd7c6c04222a743dd\r\n"]
[6.123, "o", "VERDICT=MATCH\r\n"]
[6.178, "o", "DIGEST=332f7ba20cf88b70d342becb5b4944e58cb50bda1ccd815dd7c6c04222a743dd\r\n"]
[6.233, "o", "PUBKEY=041277c6c58f2386c299c843d55e6ee5ec0389b3d329e997383ca2acb8ace759bdc6f5c7584f115cdf6de78350310facf3bc5ba472867f396fc7fa7c6738aea453\r\n"]
[6.288, "o", "SIGNS=4\r\n"]
[6.343, "o", "OK\r\n"]
[6.398, "o", "HOST_VERIFY=PASS\r\n"]
[6.453, "o", "WROTE=sealed-signature.json\r\n"]
[7.624, "o", "\u001b[2mFreshness quote: sha256(measurement || challenge), signed. Host re-derives the quote.\u001b[0m\r\n"]
[8.031, "o", "\u001b[1;32m$\u001b[0m python3 /Users/shk/code/sealed-workspace/sealed/cli/sealed.py -p /dev/cu.usbmodemV6VJDB3 attest\r\n"]
[8.031, "o", "QUOTE=8ddf4d3853bd76657f3fdf5444436907acc678f48f137ae416957886ffee6f93\r\n"]
