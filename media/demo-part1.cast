[8.141, "o", "OK\r\n"]
[8.196, "o", "HOST_VERIFY=PASS\r\n"]
[8.251, "o", "CHALLENGE=e17e88eaa11d47b22159693abd7c8ba551296bd5365932505e8ae8decd7bf2bd\r\n"]
[8.306, "o", "CHALLENGE_BOUND=PASS\r\n"]
[9.661, "o", "\u001b[2mOne page of evidence: the device's measurement vs. the digest recomputed from the ELF.\u001b[0m\r\n"]
[10.07, "o", "\u001b[1;32m$\u001b[0m python3 /Users/shk/code/sealed-workspace/sealed/cli/sealed.py -p /dev/cu.usbmodemV6VJDB3 dossier /Users/shk/code/sealed-workspace/xous-core/target/riscv32imac-unknown-xous-elf/release/dabao-console out.md\r\n"]
[10.07, "o", "WROTE=out.md\r\n"]
